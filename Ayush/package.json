{
  "name": "ayush-modules",
  "version": "0.1.0",
  "description": "API documentation, server setup, and CI/CD modules",
  "main": "dist/server.js",
  "bin": {
    "converty-server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "pretest": "mkdir -p /tmp || true",
    "test": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage-ayush-$$' jest",
    "test:watch": "NODE_OPTIONS='--localstorage-file=/tmp/jest-localstorage-ayush-$$' jest --watch",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:serve": "node scripts/serve-docs.js"
  },
  "keywords": [
    "api-docs",
    "swagger",
    "server",
    "ci-cd"
  ],
  "author": "Ayush",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

