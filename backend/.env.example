# Backend Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Database (if needed)
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=converty

# File Upload Configuration
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=10485760

# Security
# JWT_SECRET=your-secret-key-here
# CORS_ORIGIN=http://localhost:5173
